# Copy to .env and fill in. .env is git-ignored; never commit a real key.
# Install your provider: uv sync --extra google | anthropic | openai
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
# To switch provider, e.g. AI_PROVIDER=anthropic, AI_MODEL=claude-sonnet-5-5, ANTHROPIC_API_KEY=
